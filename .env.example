VITE_BUNGEE_API_KEY=your-bungee-api-key

# Optional: override the backend if Bungee provisions a dedicated or
# whitelisted frontend endpoint for your integration.
VITE_BUNGEE_API_BASE_URL=

# Optional: include if Bungee assigns an affiliate identifier.
VITE_BUNGEE_AFFILIATE=

# Optional: integrator fee configuration for quote requests.
# Example: 50 = 0.50%
VITE_BUNGEE_FEE_BPS=
VITE_BUNGEE_FEE_TAKER_ADDRESS=
